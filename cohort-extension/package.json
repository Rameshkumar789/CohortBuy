{
  "name": "cohort-extension",
  "displayName": "Cohort - Group Buying Power",
  "version": "0.0.1",
  "description": "Start or join pools to get group discounts on any product",
  "author": "Cohort Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://www.amazon.com/*",
      "https://www.amazon.co.uk/*",
      "https://www.bestbuy.com/*",
      "https://www.walmart.com/*",
      "https://www.target.com/*",
      "https://www.newegg.com/*",
      "https://www.ebay.com/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "tabs",
      "scripting"
    ]
  }
}